# Sign in as a fake user without running the backend (makable-backend on :8787): only for looking at the landing
# page and the menus. Building a site needs the backend and a real GitHub sign-in.
# VITE_MOCK_AUTH=true

# Analytics (all optional). Without a token, no analytics are sent.
# VITE_MIXPANEL_TOKEN=
# VITE_MIXPANEL_API_HOST=https://api-eu.mixpanel.com
# Log every analytics event to the browser console.
# VITE_ANALYTICS_DEBUG=true
