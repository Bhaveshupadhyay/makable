# Sign in as a fake user without running the backend (makable-backend on :8787). AI edits still need the backend
# and a real GitHub sign-in.
VITE_MOCK_AUTH=true

# Template catalog to load. Defaults to the published makable-templates catalog on GitHub Pages.
# VITE_TEMPLATE_CATALOG_URL=https://bhaveshupadhyay.github.io/makable-templates/catalog.json
