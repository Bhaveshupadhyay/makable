# Sign in as a fake user without running the control plane Worker.
VITE_MOCK_AUTH=true

# Template catalog to load. Defaults to the published makable-templates catalog on GitHub Pages.
# VITE_TEMPLATE_CATALOG_URL=https://bhaveshupadhyay.github.io/makable-templates/catalog.json

# Dev AI endpoint (POST /api/ai/content): any OpenAI-compatible chat API. Defaults to a local
# OmniRoute (`omniroute`, then add a provider in its dashboard at http://localhost:20128).
# AI_BASE_URL=http://localhost:20128/v1
# AI_API_KEY=
# AI_MODEL=auto
