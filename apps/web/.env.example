# Sign in as a fake user without running the backend (makable-backend on :8787). AI edits still need the backend
# and a real GitHub sign-in.
VITE_MOCK_AUTH=true

# Template catalog to load. Defaults to the published makable-templates catalog on GitHub Pages.
# VITE_TEMPLATE_CATALOG_URL=https://bhaveshupadhyay.github.io/makable-templates/catalog.json

# Analytics (all optional). Without a token, no analytics are sent.
# VITE_MIXPANEL_TOKEN=
# Mixpanel only gets events from deployed builds; set this to send them from localhost too.
# VITE_MIXPANEL_LOCAL=true
# VITE_MIXPANEL_API_HOST=https://api-eu.mixpanel.com
# Log every analytics event to the browser console.
# VITE_ANALYTICS_DEBUG=true
